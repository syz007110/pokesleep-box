{
  "name": "pokesleep-box",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Offline-first PWA for managing a personal Pokémon Sleep box and computing production.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc -b --noEmit",
    "update-lab": "bash scripts/update-lab-common.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dexie": "^4.2.1",
    "pinia": "^3.0.4",
    "uuid": "^11.1.0",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.8",
    "@vitejs/plugin-vue": "^6.0.1",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.0",
    "workbox-window": "^7.3.0"
  }
}
